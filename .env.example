# Configurações do Servidor
PORT=3000
SITE_URL=http://localhost:3000

# Configurações da API do PicPay
# Obtenha suas credenciais em: https://lojista.picpay.com/
# Documentação: https://developers-business.picpay.com/
PICPAY_API_URL=https://api.picpay.com
PICPAY_TOKEN=seu_token_aqui
PICPAY_SELLER_TOKEN=seu_seller_token_aqui

# Configurações do Banco de Dados PostgreSQL (obrigatórias)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=casamento
DB_USER=seu_usuario_aqui
DB_PASSWORD=sua_senha_aqui

# Informações para referência
# Chave PIX do PicPay (se tiver)
PICPAY_PIX_KEY=sua_chave_pix_aqui

# Mercado Pago (Webhook /api/webhook/mercadopago)
# Access Token de produção do app (Painel MP → Suas integrações → Credenciais)
# Usado para consultar o status real do pagamento e validar a notificação.
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxx-xxxx-xxxx-xxxx

# URL pública do frontend (usada para gerar links de convites)
# Em produção: https://gabrielsoaressn.github.io/casamento-gabriel-jessica
FRONTEND_URL=https://gabrielsoaressn.github.io/casamento-gabriel-jessica

# Token de acesso à tela admin de RSVP (/admin-rsvp.html)
# Gere uma senha forte: openssl rand -base64 24
ADMIN_TOKEN=sua-senha-admin-aqui

# Avisos por e-mail (checkout aberto, presente pago, mensagens dos convidados)
# Com Gmail: ative a verificação em duas etapas e gere uma "senha de app" em
# https://myaccount.google.com/apppasswords — a senha normal da conta não funciona.
# Sem SMTP_USER/SMTP_PASS o site funciona normalmente, só não envia os avisos.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=conta-que-envia@gmail.com
SMTP_PASS=senha-de-app-de-16-letras
EMAIL_NOTIFICACOES=gssn00@gmail.com
